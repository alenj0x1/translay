---
// La portada de Translay (/ y /es/): una página propia fuera de Starlight con el diseño de la app (web/css/tokens.css:
// oscuro neutro, sin bordes, Plus Jakarta Sans y JetBrains Mono, el énfasis violeta). El fondo de toda la página es
// un viaje hecho con las escenas de caracteres de la app: del logo al atardecer, del mar a las medusas y al fondo
// marino en el pie, a medida que se baja. Cada función se demuestra con piezas vivas hechas como en la app
// (demos.ts); el código de las escenas, el logo, la estrella y los patrones es el de la app (web/js), incrustado al
// compilar. Textos y datos en copy.ts; estilos en landing.css; novedades del CHANGELOG; versión de src/data/version.json.
import fs from "node:fs";
import path from "node:path";
import { getImage } from "astro:assets";
import "@fontsource/plus-jakarta-sans/400.css";
import "@fontsource/plus-jakarta-sans/500.css";
import "@fontsource/plus-jakarta-sans/600.css";
import "@fontsource/plus-jakarta-sans/700.css";
import "@fontsource/plus-jakarta-sans/800.css";
import "./landing.css";
import Icon from "./Icon.astro";
import { copy, perf, scenes, accents, lines, demoEnd, type Lang } from "./copy";
import version from "../../data/version.json";
import mono400 from "../../assets/fonts/jetbrains-mono-latin-400-normal.woff2?url";
import mono500 from "../../assets/fonts/jetbrains-mono-latin-500-normal.woff2?url";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = copy[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const docs = base + (lang === "es" ? "es/" : "");
const home = (l: Lang) => base + (l === "es" ? "es/" : "");
const gh = "https://github.com/alenj0x1/translay";
const latest = `${gh}/releases/latest`;

// el código de la app, tal cual: el logo, las escenas, la estrella del agente y el patrón de cada biblioteca
const web = path.join(process.cwd(), "..", "web");
const read = (f: string) => fs.readFileSync(path.join(web, f), "utf8");
// el patrón de cada biblioteca vive en vaultlook.js (antes en vaults.js)
const vaultsJs = ["js/vaultlook.js", "js/vaults.js"].filter((f) => fs.existsSync(path.join(web, f))).map(read).join("\n");
const pick = (re: RegExp) => { const m = re.exec(vaultsJs); if (!m) throw new Error(`web/js: ${re}`); return m[0]; };
const appJs = [
  "var t = (s) => s, i18nTrack = (x) => x, prefs = {};",  // lo que star.js espera de la app
  read("js/brand.js"), read("js/scenes.js"), read("js/star.js"),
  pick(/const ASCII_RAMP = [^\n]*\n/), pick(/function asciiField\([\s\S]*?\n}\n/),
].join("\n");
const starCss = read("css/components/star.css") + read("css/components/carousel.css");

// capturas reales de la app, en tamaño web (si falta una, la del reproductor)
const shots = import.meta.glob<{ default: ImageMetadata }>("../../assets/capturas/*.webp", { eager: true });
const shot = async (name: string, width = 1600) => {
  const src = (shots[`../../assets/capturas/${name}.webp`] ?? shots[`../../assets/capturas/reproductor${name.endsWith("-claro") ? "-claro" : ""}.webp`]).default;
  return (await getImage({ src, width: Math.min(width, src.width), format: "webp" })).src;
};
const pair = async (name: string, width = 1600) => ({ dark: await shot(name, width), light: await shot(`${name}-claro`, width) });
const heroShot = await pair("inicio");
const phone = await pair("movil-inicio", 520);
const tour = await Promise.all(c.tour.tabs.map(async ([id, label]) => ({ id, label, ...(await pair(id)) })));

// novedades: la última versión publicada del CHANGELOG, «Added» / «Agregado»
const changelog = fs.readFileSync(path.join(process.cwd(), "..", lang === "es" ? "CHANGELOG.es.md" : "CHANGELOG.md"), "utf8").replace(/\r\n/g, "\n");
const rel = /^## (\d+\.\d+\.\d+) · (\d{4}-\d{2}-\d{2})\n([\s\S]*?)(?=^## |$(?![\s\S]))/m.exec(changelog);
const relVersion = rel?.[1] ?? version.version;
const relDate = rel ? new Date(rel[2] + "T12:00:00").toLocaleDateString(lang === "es" ? "es-419" : "en-US", { day: "numeric", month: "long", year: "numeric" }) : "";
const addedBlock = rel ? (/^### (?:Added|Agregado)\n([\s\S]*?)(?=^### |$(?![\s\S]))/m.exec(rel[3])?.[1] ?? "") : "";
const clean = (s: string) => s.replace(/\*\*|`/g, "").replace(/\s*\([^)]*\)/g, "").replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const news = addedBlock.split(/\n(?=- )/).map((b) => b.replace(/^- /, "").trim()).filter(Boolean).map((b) => {
  const i = b.indexOf(": ");
  const area = i > 0 && i < 40 ? clean(b.slice(0, i)) : "";
  let body = clean(i > 0 && i < 40 ? b.slice(i + 2) : b);
  body = body.split(/;\s|\.\s/)[0].replace(/[.,:]$/, "");
  return { area, body: body.charAt(0).toUpperCase() + body.slice(1) };
}).slice(0, 6);

const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const data = {
  lang, perf, lines, end: demoEnd,
  player: c.player, screen: c.screen, agent: c.agent, libs: c.libs, flow: { ...c.flow, files: [c.flow.files(1), c.flow.files(2)] },
  t: { copied: c.install.copied, copy: c.install.copy, good: c.perf.good, edge: c.perf.edge, yes: c.perf.yes, noVoice: c.perf.noVoice, takes: c.perf.takes("X") },
};
const target = lang === "es" ? "es" : "en";
const plangs = [["en", "English"], ["es", "Español"], ["pt", "Português"]];
---
<html lang={lang} data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{c.meta.title}</title>
  <meta name="description" content={c.meta.description} />
  <meta property="og:title" content={c.meta.title} />
  <meta property="og:description" content={c.meta.description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="alternate" hreflang="en" href={home("en")} />
  <link rel="alternate" hreflang="es" href={home("es")} />
  <style is:inline set:html={`@font-face{font-family:"JetBrains Mono";font-weight:400;font-display:swap;src:url(${mono400}) format("woff2")}@font-face{font-family:"JetBrains Mono";font-weight:500;font-display:swap;src:url(${mono500}) format("woff2")}` + starCss} />
  <script is:inline>
    // antes de pintar: el tema de la documentación y el color de énfasis elegido aquí (violeta la primera vez)
    (() => {
      const root = document.documentElement;
      let t = "", a = "";
      try { t = localStorage.getItem("starlight-theme") || ""; a = localStorage.getItem("lp-accent") || ""; } catch {}
      if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
      root.dataset.theme = t;
      root.style.setProperty("--accent-base", /^#[0-9a-f]{6}$/i.test(a) ? a : "#7d5ba6");
    })();
  </script>
</head>
<body class="lp">
  <!-- el fondo de toda la página: un viaje por las escenas de la app (demos.ts › viaje) -->
  <canvas class="bg-scene" id="bg" aria-hidden="true"></canvas>
  <div class="depth" id="depth" aria-hidden="true"><span>{c.depth}</span><b>0 m</b></div>

  <header class="nav" id="top">
    <div class="wrap nav-in">
      <a class="brand" href={home(lang)} aria-label="Translay"><span class="wordmark" data-size="24">translay</span></a>
      <nav class="nav-links" id="nav-links">
        <a href="#features">{c.nav.features}</a>
        <a href="#custom">{c.nav.custom}</a>
        <a href="#how">{c.nav.how}</a>
        <a href="#install">{c.nav.install}</a>
        <a href={`${docs}getting-started/install/`}>{c.nav.docs}</a>
      </nav>
      <div class="nav-end">
        <div class="segs" role="group" aria-label="Language">
          <a href={home("es")} class:list={["seg", { on: lang === "es" }]} hreflang="es">ES</a>
          <a href={home("en")} class:list={["seg", { on: lang === "en" }]} hreflang="en">EN</a>
        </div>
        <button class="icon-btn" id="theme" type="button" aria-label={c.nav.theme} title={c.nav.theme}>
          <span class="only-dark"><Icon name="sun" size={18} /></span><span class="only-light"><Icon name="moon" size={18} /></span>
        </button>
        <a class="icon-btn hide-sm" href={gh} aria-label="GitHub" title="GitHub"><Icon name="brand-github" size={18} /></a>
        <a class="btn btn-accent btn-sm hide-sm" href={latest}><Icon name="download" size={16} />{c.nav.download}</a>
        <button class="icon-btn show-md" id="menu" type="button" aria-label={c.nav.menu} aria-expanded="false" aria-controls="nav-links">
          <span class="i-open"><Icon name="menu-2" size={18} /></span><span class="i-close"><Icon name="x" size={18} /></span>
        </button>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-in">
        <a class="ver" href={`${docs}changelog/`}><span>{c.hero.version} {version.version}</span><span class="ver-sep"></span><span>{c.hero.whatsNew}</span><Icon name="arrow-right" size={14} /></a>
        <h1 class="h-hero">{c.hero.t1}<br /><em>{c.hero.t2}</em></h1>
        <p class="lede">{c.hero.lede}</p>
        <div class="cta">
          <a class="btn btn-accent btn-lg" href={latest}><Icon name="brand-windows" size={18} />{c.hero.download}</a>
          <a class="btn btn-soft btn-lg" href={`${docs}getting-started/install/`}>{c.hero.docs}<Icon name="arrow-right" size={18} /></a>
        </div>
        <ul class="facts">{c.hero.facts.map((f) => <li><Icon name="check" size={15} />{f}</li>)}</ul>
      </div>
      <div class="wrap">
        <div class="hero-shot" id="tilt">
          <img class="only-dark" src={heroShot.dark} alt={c.hero.shotAlt} width="1600" height="1000" fetchpriority="high" />
          <img class="only-light" src={heroShot.light} alt={c.hero.shotAlt} width="1600" height="1000" />
        </div>
      </div>
    </section>

    <section class="stats-sec">
      <div class="wrap">
        <div class="stats">{c.stats.map((s) => <div class="stat"><b>{s.n}</b><span>{s.l}</span></div>)}</div>
        <p class="note">{c.statsNote}</p>
      </div>
    </section>

    <div id="features">
      <!-- 1 · doblaje: un reproductor de muestra con su transcripción, sus personas y cómo encaja cada frase -->
      <section class="sec" id="doblaje">
        <div class="wrap">
          <div class="sec-head"><h2>{c.player.t1}<br /><em>{c.player.t2}</em></h2><p>{c.player.sub}</p></div>
          <div class="pl" id="pl">
            <div class="pl-main">
              <div class="pl-video">
                <canvas class="mini-scene" data-scene="orbita" aria-hidden="true"></canvas>
                <p class="sub-top" id="pl-orig"></p>
                <p class="sub-bot"><span class="who-dot" id="pl-who"></span><span id="pl-tr"></span></p>
              </div>
              <div class="pl-bar">
                <button class="pl-btn" id="pl-play" type="button" aria-label={c.player.pause}><span class="i-pause"><Icon name="player-pause" size={20} /></span><span class="i-play"><Icon name="player-play" size={20} /></span></button>
                <span class="pl-time"><span id="pl-time">0:00</span> <small>/ {fmt(demoEnd)}</small></span>
                <div class="pl-track" id="pl-track">
                  {lines.map((l) => <i class="seg-who" style={`left:${(l.t / demoEnd) * 100}%;width:${((l.end - l.t) / demoEnd) * 100}%;--who:var(--who-${l.who})`}></i>)}
                  <i class="pl-comment" style={`left:${(lines[1].t / demoEnd) * 100}%`}></i>
                  <i class="pl-fill" id="pl-head"></i>
                </div>
                <button class="pl-speed" id="pl-speed" type="button" aria-label={c.player.speed}><span class="odo"><span>1×</span></span></button>
                <div class="pl-lang" id="pl-lang">
                  <button class="pl-lang-btn" id="pl-lang-btn" type="button" aria-expanded="false" aria-label="Audio"><span id="pl-lang-name">{plangs.find(([k]) => k === target)![1]}</span><Icon name="chevron-down" size={12} /></button>
                  <div class="pl-lang-menu" id="pl-lang-menu" role="group" aria-label="Audio" hidden>
                    {plangs.map(([k, l]) => <button type="button" class:list={[{ on: k === target }]} data-plang={k}>{l}</button>)}
                  </div>
                </div>
              </div>
              <div class="pl-meta"><b>{c.player.title}</b><span>{c.player.channel}</span></div>
            </div>
            <aside class="pl-side">
              <div class="segs pl-tabs" role="tablist">
                {c.player.tabs.map((tb, i) => <button type="button" role="tab" class:list={["seg", { on: i === 0 }]} data-ptab={i}>{tb}</button>)}
              </div>
              <ol class="tr" id="pl-tr-list" data-ppane="0">
                {lines.map((l, i) => (
                  <li class="tr-line" data-line={i}>
                    <button type="button" class="tr-go" data-at={l.t}>
                      <span class="tr-head"><span class="mono tr-t">{fmt(l.t)}</span><span class="tr-name" style={`--who:var(--who-${l.who})`} data-who-name={l.who}>{c.player.people[l.who]}</span></span>
                      <span class="tr-orig">{l.en}</span>
                      <span class="tr-trans" data-tr={i}></span>
                    </button>
                    {l.code && <div class="tr-code"><code>{l.code}</code><button type="button" class="tr-copy" data-copy={l.code}><Icon name="copy" size={14} /><span>{c.player.copy}</span></button></div>}
                    {i === 1 && <p class="tr-comment"><Icon name="message-circle" size={14} />{c.player.comment}</p>}
                  </li>
                ))}
              </ol>
              <div class="pl-lumi" data-ppane="1" hidden>
                <div class="pl-lumi-head"><span class="pl-lumi-star" id="pl-lumi-star"></span><b>{c.agent.name}</b><span class="status"><i></i>{c.agent.on}</span></div>
                <div class="sum-card">
                  <span class="lbl">{c.player.summary}</span>
                  <p>{c.player.summaryLead}</p>
                  <ul class="sum-points">{c.player.summaryPoints.map(([t, p]: any) => <li><button type="button" class="moment" data-at={t}><span class="t">▶ {fmt(t)}</span>{p}</button></li>)}</ul>
                </div>
                <div class="chips">{c.agent.chips.map(([q]: any, i: number) => <button type="button" class="chip" data-chip={i} data-jump="agente"><Icon name="sparkles" size={14} />{q}</button>)}</div>
              </div>
              <div class="pl-next" data-ppane="2" hidden>
                {c.player.next.map(([title, ch, dur, col]: any, i: number) => (
                  <button type="button" class="next-item" style={`--vc:${col}`}>
                    <span class="next-thumb"><pre class="next-ascii" data-next={i} aria-hidden="true"></pre><span class="next-dur">{dur}</span></span>
                    <span class="next-t"><b>{title}</b><span>{ch}</span></span>
                  </button>
                ))}
                <p class="next-auto"><span class="switch on"><i></i></span>{c.player.autoplay}</p>
              </div>
              <div class="people" id="pl-people" data-ppane="3" hidden>
                {c.player.people.map((n, w) => (
                  <div class="person" style={`--who:var(--who-${w})`}>
                    <div class="person-head">
                      <span class="avatar" data-avatar={w}>{n[0]}</span>
                      <span class="person-name" contenteditable="plaintext-only" spellcheck="false" data-person={w} title={c.player.rename}>{n}</span>
                      <button type="button" class="ref-play" data-ref-play={w} aria-label={c.player.listen} title={c.player.listen}><span class="i-play"><Icon name="player-play" size={15} /></span><span class="i-pause"><Icon name="player-pause" size={15} /></span></button>
                    </div>
                    <div class="ref"><span class="ref-bars" data-ref={w}>{Array.from({ length: 26 }, () => <i></i>)}</span><span class="ref-len">{c.player.ref}</span></div>
                    <div class="voice-row">
                      <span class="lbl">{c.player.voice}</span>
                      <div class="segs">{c.player.voices.map((v, k) => <button type="button" class:list={["seg", { on: k === 0 }]} data-voice={`${w}:${k}`}>{k === 1 ? v.replace("{name}", c.player.people[1 - w]) : v}</button>)}</div>
                    </div>
                  </div>
                ))}
              </div>
            </aside>
          </div>
          <div class="fit" aria-hidden="true">
            <div class="fit-row"><span class="lbl">{c.player.slot}</span><span class="fit-bar slot mono" id="fit-slot"></span></div>
            <div class="fit-row"><span class="lbl">{c.player.take}</span><span class="fit-bar take mono" id="fit-take"></span></div>
            <p class="fit-note"><Icon name="check" size={15} />{c.player.fits}<span class="mono">· {c.player.lagLabel} {lang === "es" ? "0,08" : "0.08"} s</span></p>
          </div>
        </div>
      </section>

      <!-- 2 · el texto del video: una diapositiva con lo que se lee, traducido encima, y lo que se puede hacer con cada texto -->
      <section class="sec" id="pantalla">
        <div class="wrap split">
          <div class="split-text">
            <h2>{c.screen.t1}<br /><em>{c.screen.t2}</em></h2>
            <p class="sub">{c.screen.sub}</p>
            <button class="switch-row" type="button" id="st-toggle" aria-pressed="true"><span class="switch on"><i></i></span>{c.screen.toggle}</button>
            <ul class="points">{c.screen.points.map(([ic, txt]) => <li><span class="pt-ic"><Icon name={ic} size={17} /></span><span>{txt}</span></li>)}</ul>
          </div>
          <div class="slide-wrap">
            <div class="slide on" id="slide">
              {c.screen.items.map(([o, tr, kind], i) => (
                <span class={`st st-${kind}`} data-st={i} data-kind={kind} tabindex="0">
                  <span class="st-orig">{o}</span>{tr && <span class="st-tr">{tr}</span>}
                </span>
              ))}
              <canvas class="mini-scene slide-art" data-scene="lechuga" aria-hidden="true"></canvas>
              <div class="st-box" id="st-box" hidden>
                <button type="button" data-st-act="copy"><Icon name="copy" size={14} /><span>{c.screen.copy}</span></button>
                <i class="st-sep" data-st-open hidden></i>
                <button type="button" data-st-act="open" data-st-open hidden><Icon name="external-link" size={14} />{c.screen.open}</button>
                <i class="st-sep"></i>
                <button type="button" data-st-act="ask"><span class="st-star" id="st-star"></span>{c.screen.ask}</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 · el agente: su conversación y el creador de la estrella, los dos en vivo -->
      <section class="sec" id="agente">
        <div class="wrap">
          <div class="sec-head"><h2>{c.agent.t1}<br /><em>{c.agent.t2}</em></h2><p>{c.agent.sub}</p></div>
          <div class="ag">
            <div class="chat">
              <div class="chat-head"><span class="chat-av" id="ag-av"></span><b>{c.agent.name}</b><span class="status"><i></i>{c.agent.on}</span></div>
              <div class="chat-body" id="ag-body">
                <div class="chat-empty" id="ag-empty"><span class="big-star" id="ag-big"></span><b>{c.agent.name}</b></div>
                <div class="msgs" id="ag-msgs"></div>
              </div>
              <div class="chips" id="ag-chips">{c.agent.chips.map(([q], i) => <button type="button" class="chip" data-chip={i}><Icon name="sparkles" size={14} />{q}</button>)}</div>
              <div class="ask-box"><span>{c.agent.ask}</span><span class="ask-ic"><Icon name="microphone" size={16} /></span><span class="ask-send"><Icon name="arrow-up" size={16} /></span></div>
            </div>
            <div class="maker">
              <div class="maker-parts">
                {["shape", "eyes", "mouth", "cheeks", "acc"].map((k, i) => <div class="star-part"><span>{c.agent.parts[i]}</span><div data-part={k}></div></div>)}
                <div class="star-part"><span>{c.agent.color}</span><div class="swatches sm" id="mk-colors"></div></div>
              </div>
              <div class="maker-stage"><span class="star-big" id="mk-star"></span><button class="btn btn-ghost btn-sm" type="button" id="mk-random"><Icon name="dice" size={16} />{c.agent.random}</button></div>
            </div>
          </div>
          <ul class="points row3">{c.agent.points.map(([ic, txt]) => <li><span class="pt-ic"><Icon name={ic} size={17} /></span><span>{txt}</span></li>)}</ul>
        </div>
      </section>

      <!-- 4 · bibliotecas: cada una con su patrón de caracteres, y la búsqueda en todo lo dicho -->
      <section class="sec" id="bibliotecas">
        <div class="wrap">
          <div class="sec-head"><h2>{c.libs.t1}<br /><em>{c.libs.t2}</em></h2><p>{c.libs.sub}</p></div>
          <div class="libs">
            <div class="lib-hero" id="lib-hero">
              <pre class="lib-ascii" id="lib-ascii" aria-hidden="true"></pre>
              <div class="lib-acts"><button class="btn btn-glass btn-sm" type="button" id="lib-shuffle"><Icon name="arrows-shuffle" size={16} />{c.libs.reshuffle}</button></div>
              <div class="lib-id"><span class="lib-badge" id="lib-badge"></span><div><b id="lib-name"></b><span id="lib-count"></span></div></div>
            </div>
            <div class="lib-side">
              <div class="lib-cards" id="lib-cards">
                {c.libs.list.map(([n, col, ic, count], i) => (
                  <button type="button" class:list={["lib-card", { on: i === 0 }]} data-lib={i} data-name={n} data-count={`${count} ${c.libs.videos}`} style={`--vc:${col}`}>
                    <pre class="lib-peek" aria-hidden="true"></pre>
                    <span class="lib-badge sm"><Icon name={ic as string} size={18} /></span>
                    <span class="lib-card-t"><b>{n}</b><span>{count} {c.libs.videos}</span></span>
                  </button>
                ))}
              </div>
              <div class="search-demo">
                <div class="search-box"><Icon name="search" size={16} /><span id="sq"></span><i class="caret"></i></div>
                <ul class="hits" id="hits">{c.libs.hits.map((h) => <li set:html={h} />)}</ul>
              </div>
            </div>
          </div>
          <ul class="points row3">{c.libs.points.map(([ic, txt]) => <li><span class="pt-ic"><Icon name={ic} size={17} /></span><span>{txt}</span></li>)}</ul>
        </div>
      </section>

      <!-- 5 · agregar, la cola y exportar -->
      <section class="sec" id="flow">
        <div class="wrap">
          <div class="sec-head"><h2>{c.flow.t1}<br /><em>{c.flow.t2}</em></h2><p>{c.flow.sub}</p></div>
          <div class="flow">
            <div class="card flow-add">
              <div class="add-box"><Icon name="link" size={16} /><span class="add-in" id="add-in">{c.flow.ph}</span><button class="btn btn-accent btn-sm" type="button" id="add-go"><Icon name="plus" size={16} />{c.flow.add}</button></div>
              <div class="ways">{c.flow.ways.map((w) => <span class="way">{w}</span>)}</div>
              <span class="lbl">{c.flow.queue}</span>
              <ul class="jobs" id="jobs"></ul>
            </div>
            <div class="card flow-export">
              <div class="exp-head"><span class="exp-thumb"><canvas class="mini-scene" data-scene="orbita" aria-hidden="true"></canvas></span><div><b>{c.player.title}</b><span class="muted small">{c.player.channel}</span></div></div>
              <div class="exp-cards">
                {c.flow.cards.map(([ic, name, opts]: any, i) => (
                  <div class="exp-card" data-exp={i}>
                    <span class="exp-name"><Icon name={ic} size={18} />{name}</span>
                    <div class="pills">{opts.map((o: string, k: number) => <button type="button" class:list={["pill-opt", { on: k === 0 && i !== 1 }]} data-pill>{o}</button>)}</div>
                  </div>
                ))}
              </div>
              <button class="btn btn-accent exp-go" type="button" id="exp-go"><Icon name="download" size={18} /><span id="exp-n"></span></button>
            </div>
          </div>
        </div>
      </section>
    </div>

    <!-- cómo funciona: una frase que pasa por las cinco etapas -->
    <section class="sec" id="how">
      <div class="wrap">
        <div class="sec-head"><h2>{c.how.t1}<br /><em>{c.how.t2}</em></h2><p>{c.how.sub}</p></div>
        <ol class="pipe" id="pipe">
          {c.how.steps.map(([ic, k, d], i) => (
            <li class="pipe-step" data-step={i}>
              <span class="chip-ic"><Icon name={ic} size={20} /></span>
              <h3>{k}</h3>
              <div class="pipe-viz">
                {i === 0 && <><span class="wave mono" data-wave></span><span class="pill">{c.how.detected}</span></>}
                {i === 1 && <span class="voices"><i style="--who:var(--who-0)">{c.player.people[0]}</i><i style="--who:var(--who-1)">{c.player.people[1]}</i></span>}
                {i === 2 && <span class="trans"><s>{c.how.said}</s><b>{c.how.trans}</b></span>}
                {i === 3 && <span class="refbar"><i></i><span class="mono">8 s</span></span>}
                {i === 4 && <span class="fitbars"><i class="a"></i><i class="b"></i></span>}
              </div>
              <p>{d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- hazlo tuyo: el fondo de esta página, la escena y el color -->
    <section class="sec" id="custom">
      <div class="wrap">
        <div class="custom card">
          <div class="custom-text">
            <h2>{c.custom.t1}<br /><em>{c.custom.t2}</em></h2>
            <p class="sub">{c.custom.sub}</p>
            <p class="muted small">{c.custom.note}</p>
          </div>
          <div class="custom-ctl">
            <div class="ctl-row"><span class="lbl">{c.custom.scene}</span>
              <div class="scene-opts">{scenes.map((s, i) => <button type="button" class:list={["opt", { on: i === 0 }]} data-scene-pick={s.id}>{s[lang]}</button>)}</div>
            </div>
            <div class="ctl-row"><span class="lbl">{c.custom.accent}</span>
              <div class="swatches">{accents.map((a) => <button type="button" class="swatch" data-accent={a.c} style={`--vc:${a.c}`} title={a[lang]} aria-label={a[lang]}></button>)}</div>
            </div>
            <div class="ctl-row"><span class="lbl">{c.custom.mode}</span>
              <div class="segs"><button type="button" class="seg" data-mode="light"><Icon name="sun" size={15} />{c.custom.light}</button><button type="button" class="seg" data-mode="dark"><Icon name="moon" size={15} />{c.custom.dark}</button></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- capturas reales, sin nada detrás -->
    <section class="sec" id="tour">
      <div class="wrap">
        <div class="sec-head"><h2>{c.tour.t1}<br /><em>{c.tour.t2}</em></h2><p>{c.tour.sub}</p></div>
        <div class="tour-tabs segs">{tour.map((s, i) => <button type="button" class:list={["seg", { on: i === 0 }]} data-tour={i}>{s.label}</button>)}</div>
        <div class="tour-shot">
          {tour.map((s, i) => (
            <div class:list={["tour-pane", { on: i === 0 }]} data-tour-pane={i}>
              <img class="only-dark" src={s.dark} alt={`${c.tour.alt}: ${s.label}`} width="1600" height="1000" loading="lazy" />
              <img class="only-light" src={s.light} alt={`${c.tour.alt}: ${s.label}`} width="1600" height="1000" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec" id="more">
      <div class="wrap">
        <div class="sec-head"><h2>{c.more.t1}<br /><em>{c.more.t2}</em></h2></div>
        <div class="grid3">{c.more.items.map(([ic, t, d]) => <article class="card mini"><span class="chip-ic"><Icon name={ic} size={20} /></span><h3>{t}</h3><p>{d}</p></article>)}</div>
      </div>
    </section>

    <section class="sec" id="performance">
      <div class="wrap">
        <div class="sec-head"><h2>{c.perf.t1}<br /><em>{c.perf.t2}</em></h2><p>{c.perf.sub}</p></div>
        <div class="perf">
          <div class="card perf-main">
            <span class="lbl">{c.perf.pick}</span>
            <div class="segs wide" role="group" aria-label={c.perf.pick}>
              {perf.map((p, i) => <button type="button" class:list={["seg", { on: i === 0 }]} data-gpu={i}>{p.gpu === "cpu" ? c.perf.cpu : p.gpu}</button>)}
            </div>
            <div class="perf-out">
              <div><span class="lbl">{c.perf.profile}</span><b class="perf-name" id="pf-name">{perf[0].profile[lang]}</b></div>
              <div class="perf-chips"><span class="pill" id="pf-voice"><Icon name="microphone" size={15} /><span>{c.perf.yes}</span></span><span class="pill" id="pf-state">{c.perf.good}</span></div>
            </div>
            <div class="speed">
              <div class="speed-head"><span class="lbl">{c.perf.speed}</span><b id="pf-speed">{perf[0].speed}×</b></div>
              <div class="speed-track"><i class="speed-fill" id="pf-fill"></i><i class="speed-live" style={`left:${(1 / 3.5) * 100}%`}><span>{c.perf.live}</span></i></div>
            </div>
            <div class="perf-mem"><div><span class="lbl">{c.perf.vram}</span><b id="pf-vram">~4.6 GB</b></div><div><span class="lbl">{c.perf.ram}</span><b id="pf-ram">~12 GB</b></div></div>
            <p class="perf-takes"><Icon name="clock" size={16} /><span id="pf-takes">{c.perf.takes("5")}</span></p>
          </div>
          <div class="perf-side">{c.perf.cards.map(([ic, t, d]) => <article class="card mini"><span class="chip-ic"><Icon name={ic} size={20} /></span><h3>{t}</h3><p>{d}</p></article>)}</div>
        </div>
      </div>
    </section>

    <section class="sec" id="access">
      <div class="wrap access">
        <div>
          <div class="sec-head left"><h2>{c.access.t1}<br /><em>{c.access.t2}</em></h2><p>{c.access.sub}</p></div>
          <div class="grid2">{c.access.items.map(([ic, t, d]) => <article class="card mini"><span class="chip-ic"><Icon name={ic} size={20} /></span><h3>{t}</h3><p>{d}</p></article>)}</div>
        </div>
        <div class="phone">
          <img class="only-dark" src={phone.dark} alt={c.access.phoneAlt} width="390" height="844" loading="lazy" />
          <img class="only-light" src={phone.light} alt={c.access.phoneAlt} width="390" height="844" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="sec" id="install">
      <div class="wrap">
        <div class="sec-head"><h2>{c.install.t1}<br /><em>{c.install.t2}</em></h2><p>{c.install.sub}</p></div>
        <div class="inst">
          <div class="card inst-main">
            <div class="segs" role="tablist">
              {c.install.tabs.map((t, i) => <button type="button" role="tab" class:list={["seg", { on: i === 0 }]} data-inst={i}><Icon name={["brand-windows", "brand-docker", "terminal-2"][i]} size={16} />{t}</button>)}
            </div>
            <div class="stack">
              <div class="pane on" data-inst-pane="0">
                <ol class="isteps">{c.install.win.map(([t, dd], i) => <li><span class="n">{i + 1}</span><span><b>{t}</b><span>{dd}</span></span></li>)}</ol>
                <a class="btn btn-accent" href={latest}><Icon name="download" size={18} />{c.install.winCta}</a>
              </div>
              <div class="pane" data-inst-pane="1">
                <div class="code-box"><button class="copy" type="button"><Icon name="copy" size={15} /><span>{c.install.copy}</span></button><pre class="code"><code>git clone https://github.com/alenj0x1/translay.git && cd translay{"\n"}cp .env.example .env    <span class="c"># {lang === "es" ? "y cambia" : "and change"} TRANSLAY_OWNER_PASSWORD</span>{"\n"}docker compose up -d --build</code></pre></div>
                <p class="muted">{c.install.docker}</p>
              </div>
              <div class="pane" data-inst-pane="2">
                <div class="code-box"><button class="copy" type="button"><Icon name="copy" size={15} /><span>{c.install.copy}</span></button><pre class="code"><code>git clone https://github.com/alenj0x1/translay.git && cd translay{"\n"}pip install -r requirements.txt{"\n"}uv venv -p 3.11 .venvs/omnivoice{"\n"}uv pip install -p .venvs/omnivoice/Scripts/python.exe --torch-backend=cu128 omnivoice deepfilternet soundfile{"\n"}python run.py</code></pre></div>
                <p class="muted">{c.install.source}</p>
              </div>
            </div>
          </div>
          <article class="card"><dl class="req">{c.install.req.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl></article>
        </div>
      </div>
    </section>

    {news.length > 0 && (
      <section class="sec" id="news">
        <div class="wrap">
          <div class="sec-head"><h2>{c.news.t1}<br /><em>{c.news.t2} {relVersion}</em></h2><p>{c.news.released} {relDate}.</p></div>
          <div class="grid3">{news.map((n) => <article class="card mini">{n.area && <span class="lbl accent">{n.area}</span>}<p>{n.body}</p></article>)}</div>
          <a class="btn btn-soft news-all" href={`${docs}changelog/`}>{c.news.all}<Icon name="arrow-right" size={18} /></a>
        </div>
      </section>
    )}

    <section class="sec" id="faq">
      <div class="wrap narrow">
        <div class="sec-head"><h2>{c.faq.t1}<br /><em>{c.faq.t2}</em></h2></div>
        <div class="faq">{c.faq.items.map(([q, a]) => <details class="card"><summary>{q}<Icon name="plus" size={18} /></summary><p>{a}</p></details>)}</div>
      </div>
    </section>
  </main>

  <!-- el pie: el fondo del mar, donde termina el viaje -->
  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-brand">
        <a class="brand" href={home(lang)} aria-label="Translay"><span class="wordmark" data-size="24">translay</span></a>
        <p>{c.footer.tagline}</p>
      </div>
      <div class="foot-col"><b>{c.footer.product}</b><a href="#features">{c.nav.features}</a><a href="#custom">{c.nav.custom}</a><a href="#how">{c.nav.how}</a><a href="#install">{c.nav.install}</a></div>
      <div class="foot-col"><b>{c.footer.docsCol}</b><a href={`${docs}getting-started/install/`}>{c.footer.start}</a><a href={`${docs}guide/player/`}>{c.footer.guide}</a><a href={`${docs}integrations/api/`}>{c.footer.api}</a><a href={`${docs}changelog/`}>{c.footer.changelog}</a></div>
      <div class="foot-col"><b>{c.footer.project}</b><a href={gh}>GitHub</a><a href={`${gh}/releases`}>{c.footer.releases}</a><a href={`${gh}/issues`}>{c.footer.issues}</a></div>
    </div>
    <div class="wrap foot-legal"><span>{c.footer.license}</span><span>v{version.version}</span></div>
  </footer>

  <script type="application/json" id="lp-data" set:html={JSON.stringify(data)} />
  <script is:inline set:html={appJs} />
</body>
</html>

<script>
  import "./demos";
</script>
