---
// Banner Bauhaus, el mismo generador de la app (web/js/patterns.js): misma semilla → mismo patrón.
interface Props { seed?: string; cols?: number; rows?: number; main?: string }
const { seed = "translay", cols = 18, rows = 3, main } = Astro.props;

const PALETTES = [
  ["#e8a13a", "#d9534f", "#3a7ca5", "#f1e3c8"],
  ["#5b8def", "#9b6bd6", "#2bb3a3", "#1f2a44"],
  ["#f06c9b", "#ffb86b", "#7bd389", "#2b2340"],
  ["#3fbf74", "#e3c14f", "#3a7bd5", "#16302b"],
  ["#ff7a59", "#ffd166", "#118ab2", "#073b4c"],
  ["#c084fc", "#60a5fa", "#f472b6", "#1e1b3a"],
  ["#ef6f6c", "#f7b267", "#4d9de0", "#fdf0d5"],
  ["#2ec4b6", "#ff9f1c", "#e71d36", "#011627"],
];
function seeded(text: string) {
  let h = 2166136261;
  for (const ch of text) h = Math.imul(h ^ ch.codePointAt(0)!, 16777619);
  return () => {
    h = Math.imul(h ^ (h >>> 15), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return ((h ^= h >>> 16) >>> 0) / 4294967296;
  };
}
const rp = seeded(seed);
let c = PALETTES[Math.floor(rp() * PALETTES.length)];
if (main) c = [main, c[1] === main ? c[0] : c[1], c[2], c[3]];
const r = seeded(seed + "·shapes");
const z = 10;
let s = `<rect width="${cols * z}" height="${rows * z}" fill="${c[3]}"/>`;
for (let x = 0; x < cols; x++) {
  for (let y = 0; y < rows; y++) {
    const X = x * z, Y = y * z, cx = X + z / 2, cy = Y + z / 2;
    const k = Math.floor(r() * 5), f = c[Math.floor(r() * 3)], rot = Math.floor(r() * 4) * 90;
    const t = `transform="rotate(${rot} ${cx} ${cy})"`;
    if (k === 0) s += `<circle cx="${cx}" cy="${cy}" r="${z / 2 - 0.8}" fill="${f}"/>`;
    else if (k === 1) s += `<path d="M${X} ${Y + z}A${z} ${z} 0 0 1 ${X + z} ${Y}V${Y + z}Z" fill="${f}" ${t}/>`;
    else if (k === 2) s += `<path d="M${X} ${Y}L${X + z} ${Y + z}H${X}Z" fill="${f}" ${t}/>`;
    else if (k === 3) s += `<path d="M${X} ${Y + z}A${z / 2} ${z / 2} 0 0 1 ${X + z} ${Y + z}Z" fill="${f}" ${t}/>`;
    else s += `<rect x="${X + 2}" y="${Y + 2}" width="${z - 4}" height="${z - 4}" rx="1" fill="${f}"/>`;
  }
}
const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${cols * z} ${rows * z}" preserveAspectRatio="xMidYMid slice">${s}</svg>`;
const bg = `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
---
<div class="bauhaus not-content" aria-hidden="true" style={`background-image: ${bg}`}></div>

<style>
  .bauhaus {
    height: clamp(88px, 14vw, 150px);
    margin-block: 1.5rem;
    border-radius: 18px;
    background-size: cover;
    background-position: center;
  }
</style>
