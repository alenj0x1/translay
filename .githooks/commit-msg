#!/bin/sh
# Validates the commit message: Conventional Commits in English + docs kept up to date.
# Enable once per clone:  git config core.hooksPath .githooks
#
#   type(optional scope)!: imperative summary in lowercase, no trailing period (max. 72)
#
# Types: feat fix perf refactor style docs test build ci chore revert
# A feat/fix/perf that touches vt/, web/, desktop/, Dockerfile or requirements.txt must also
# change docs/ or the changelogs. If it really doesn't need it, end the message with the line
#   Docs: n/a

msg_file="$1"
header=$(grep -v '^#' "$msg_file" | sed -n '/./{p;q;}')

# commits git writes by itself
case "$header" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|fix|perf|refactor|style|docs|test|build|ci|chore|revert'
if ! printf '%s' "$header" | grep -Eq "^($types)(\([a-z0-9/._-]+\))?!?: [a-z0-9].*[^.]$"; then
  cat >&2 <<MSG

  ✗ The message does not follow the commit convention.

    type(scope): imperative summary
    e.g. feat(queue): prioritize from the card
         fix(voice): stop trimming reference clips
         docs: export guide

    Types: feat fix perf refactor style docs test build ci chore revert
    English, lowercase, no trailing period. "!" before ":" marks a breaking change.
    Details: docs/src/content/docs/development/commits.mdx

  Got: $header
MSG
  exit 1
fi

if [ ${#header} -gt 72 ]; then
  echo "  ✗ The first line has ${#header} characters (max. 72)." >&2
  exit 1
fi

# docs up to date (CI only checks the format: VT_SOLO_FORMATO=1)
[ -n "$VT_SOLO_FORMATO" ] && exit 0
type=$(printf '%s' "$header" | sed -E 's/^([a-z]+).*/\1/')
case "$type" in
  feat|fix|perf)
    if grep -qiE '^Docs: (n/a|no aplica)' "$msg_file"; then exit 0; fi
    staged=$(git diff --cached --name-only)
    code=$(printf '%s\n' "$staged" | grep -E '^(vt/|web/|desktop/|Dockerfile|docker-compose.yml|requirements.txt|run.py)' | head -1)
    docs=$(printf '%s\n' "$staged" | grep -E '^(docs/src/content/|CHANGELOG(\.es)?\.md|README(\.es)?\.md)' | head -1)
    if [ -n "$code" ] && [ -z "$docs" ]; then
      cat >&2 <<MSG

  ✗ This $type changes the app but not the documentation.

    Update the matching page in docs/src/content/docs/ (English and es/) and add the
    change to CHANGELOG.md ("Unreleased") and CHANGELOG.es.md ("Sin publicar").
    If it really isn't needed, end the message with the line:  Docs: n/a
MSG
      exit 1
    fi
    ;;
esac
exit 0
